# file extensions
**/*.pyc
**/*.pyc.*
**/__pycache__/
**/*.h5
**/*.p
!test/test_data/*.p
*.swp
.coverage

# folder
.worktrees/
build/*
dist/*
neuralhydrology.egg-info/*
.vscode/*
.idea/*
runs/
configs/*
.ipynb_checkpoints/
data/*
docs/build/*

# Security - credentials
hpc密码.txt
.cdsapirc

# Temporary files
temp_*.txt
move_log.txt
sync.ffs_db
tmpclaude-*
module_a_validation/
# scratch run logs and one-off probe scripts (125 .log files as of 2026-08-19);
# anything worth keeping belongs in logs/<ID>/ or src/<idea>/scripts/
/tmp/

# Root-level logs (project logs are in logs/<ID>/)
/*.log

# Keep per-idea directory structure, but do not track run artifacts
logs/**
!logs/.gitkeep
!logs/*/
!logs/*/.gitkeep

results/**
!results/.gitkeep
!results/*/
!results/*/.gitkeep

# HPC distribution artifacts
dist_hpc/
!dist_hpc/
dist_hpc/*
!dist_hpc/README.md

# Local vendored repos (keep local, do not track)
external/

# Claude Code / local session state
.claude/
resume_sessions.bat

# LaTeX build artifacts in paper drafts (keep .tex/.bib/figures)
draft/papers/**/*.aux
draft/papers/**/*.bbl
draft/papers/**/*.blg
draft/papers/**/*.log
draft/papers/**/*.out
draft/papers/**/*.synctex.gz
draft/papers/**/*.fdb_latexmk
draft/papers/**/*.fls
draft/papers/**/*.toc
# Redundant paper zip snapshots
draft/papers/**/*.zip

# Generated test configs (created by src/test_data/scripts/create_test_data.py)
src/test_data/configs/*.yml
src/test_data/configs/*.txt
!src/test_data/configs/README.md

!runs/README.md
!results/README.md

